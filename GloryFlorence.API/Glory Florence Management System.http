@HostAddress = http://localhost:5222

### 1. Login as Super Admin (Username: admin, Password: Admin123!)
# @name loginSuperAdmin
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin123!"
}

