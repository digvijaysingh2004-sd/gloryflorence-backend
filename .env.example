# ==========================================
# Glory Florence API - Environment Variables
# ==========================================
# Copy this file to .env or configure in your deployment environment.
# Note: .env files containing real secrets should NEVER be committed to Git!

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5222;https://+:7145

# Database Connection (SQL Server)
ConnectionStrings__DefaultConnection="Server=localhost;Database=GloryFlorenceDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# JWT Authentication
JwtSettings__Secret="ReplaceWithAStrongSecretKeyAtLeast32CharactersLong123!"
JwtSettings__Issuer="GloryFlorenceAPI"
JwtSettings__Audience="GloryFlorenceClient"
JwtSettings__ExpiryInMinutes=180
